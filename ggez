/*
 * Smart security system - Arduino side.
 * Drives the alarm LED, status LED and a 16x2 I2C LCD.
 * Receives one-line commands from the Raspberry Pi over USB serial at 9600 baud:
 *
 *   ALARM       start flashing the alarm LED (keeps flashing until RESET)
 *   COUNT n     update the detection count shown on the LCD
 *   RESET       alarm LED off, status LED steady on, count back to 0
 *   STATUS_ON   status LED on
 *   STATUS_OFF  status LED off (system stopped)
 */

#include <Wire.h>
#include <LiquidCrystal_I2C.h>

const int ALARM_LED  = 8;
const int STATUS_LED = 9;

const unsigned long ALARM_FLASH_MS = 150;   // alarm LED on/off period

LiquidCrystal_I2C lcd(0x27, 16, 2);        // if the screen stays blank, try 0x3F

bool alarmOn = false;
unsigned long lastAlarmToggle = 0;
long detections = 0;

void showStatus(const char *state) {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Detections: ");
  lcd.print(detections);
  lcd.setCursor(0, 1);
  lcd.print(state);
}

void setup() {
  pinMode(ALARM_LED, OUTPUT);
  pinMode(STATUS_LED, OUTPUT);
  digitalWrite(ALARM_LED, LOW);
  digitalWrite(STATUS_LED, HIGH);   // armed = steady on
  Serial.begin(9600);

  lcd.init();
  lcd.backlight();
  showStatus("ARMED");
}

void handleCommand(const String &cmd) {
  if (cmd == "ALARM") {
    alarmOn = true;
  } else if (cmd.startsWith("COUNT ")) {
    detections = cmd.substring(6).toInt();
    showStatus("ALARM!");
  } else if (cmd == "RESET") {
    alarmOn = false;
    detections = 0;
    digitalWrite(ALARM_LED, LOW);
    digitalWrite(STATUS_LED, HIGH);
    showStatus("ARMED");
  } else if (cmd == "STATUS_ON") {
    digitalWrite(STATUS_LED, HIGH);
  } else if (cmd == "STATUS_OFF") {
    alarmOn = false;
    digitalWrite(STATUS_LED, LOW);
    digitalWrite(ALARM_LED, LOW);
    showStatus("OFF");
  }
}

void loop() {
  if (Serial.available()) {
    String cmd = Serial.readStringUntil('\n');
    cmd.trim();
    handleCommand(cmd);
  }

  if (alarmOn && millis() - lastAlarmToggle >= ALARM_FLASH_MS) {
    lastAlarmToggle = millis();
    digitalWrite(ALARM_LED, !digitalRead(ALARM_LED));
  }
}
